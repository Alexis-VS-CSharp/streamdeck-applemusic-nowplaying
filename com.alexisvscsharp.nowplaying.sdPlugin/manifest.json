{
  "Name": "Apple Music Now Playing",
  "Author": "Alexis-VS-CSharp",
  "UUID": "com.alexisvscsharp.nowplaying",
  "Icon": "imgs/plugin/category-icon",
  "Description": "Affiche le titre en cours de lecture sur Apple Music (Windows) et permet de mettre en pause/reprendre.",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Version": "1.0.0.0",
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
  "Category": "Apple Music Now Playing",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Actions": [
    {
      "Name": "Now Playing",
      "UUID": "com.alexisvscsharp.nowplaying.nowplaying",
      "Icon": "imgs/actions/now-playing/icon",
      "Tooltip": "Affiche le morceau en cours sur Apple Music. Appui = pause/lecture, rotation = piste suivante/précédente.",
      "PropertyInspectorPath": "ui/now-playing.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/now-playing.json",
        "TriggerDescription": {
          "Rotate": "Piste précédente / suivante",
          "Push": "Lecture / Pause",
          "Touch": "Lecture / Pause"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/now-playing/key",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "Name": "Lecture / Pause",
      "UUID": "com.alexisvscsharp.nowplaying.playpause",
      "Icon": "imgs/actions/control/pause",
      "Tooltip": "Met en pause ou reprend la lecture Apple Music.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/control/pause"
        }
      ]
    },
    {
      "Name": "Piste precedente",
      "UUID": "com.alexisvscsharp.nowplaying.previous",
      "Icon": "imgs/actions/control/prev",
      "Tooltip": "Piste precedente sur Apple Music.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/control/prev"
        }
      ]
    },
    {
      "Name": "Piste suivante",
      "UUID": "com.alexisvscsharp.nowplaying.next",
      "Icon": "imgs/actions/control/next",
      "Tooltip": "Piste suivante sur Apple Music.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/control/next"
        }
      ]
    },
    {
      "Name": "Volume +",
      "UUID": "com.alexisvscsharp.nowplaying.volume-up",
      "Icon": "imgs/actions/control/volume-up",
      "Tooltip": "Augmente le volume systeme.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/control/volume-up"
        }
      ]
    },
    {
      "Name": "Volume -",
      "UUID": "com.alexisvscsharp.nowplaying.volume-down",
      "Icon": "imgs/actions/control/volume-down",
      "Tooltip": "Diminue le volume systeme.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/control/volume-down"
        }
      ]
    },
    {
      "Name": "Muet",
      "UUID": "com.alexisvscsharp.nowplaying.mute",
      "Icon": "imgs/actions/control/mute",
      "Tooltip": "Coupe/retablit le son d'Apple Music (memorise le volume precedent).",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/control/mute"
        }
      ]
    },
    {
      "Name": "Lancer playlist / album",
      "UUID": "com.alexisvscsharp.nowplaying.play-media",
      "Icon": "imgs/actions/now-playing/icon",
      "Tooltip": "Lance une playlist ou un album Apple Music (configurer le lien dans les parametres de l'action).",
      "PropertyInspectorPath": "ui/play-media.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/now-playing/key"
        }
      ]
    }
  ]
}